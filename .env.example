# Meta / WhatsApp Cloud API
PORT=3000
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-meta-verification-token
WHATSAPP_ACCESS_TOKEN=replace-with-a-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-whatsapp-phone-number-id

# Must exactly match NIPRIX_META_WEBHOOK_SECRET in the CRM.
CRM_WEBHOOK_URL=http://127.0.0.1:8000/api/integrations/webhooks/whatsapp/
CRM_WEBHOOK_SECRET=replace-with-the-shared-crm-webhook-secret

# Use a shared persistent volume if the bot runs in multiple instances.
CONVERSATION_STORE_PATH=./data/conversations.json
CONVERSATION_TTL_SECONDS=86400
OUTBOUND_TIMEOUT_MS=10000
